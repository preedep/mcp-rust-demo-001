# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# This file holds anything that identifies your deployment. Keeping it out of git
# means a public repo does not advertise a reachable endpoint to probe.

# API key the Envoy Gateway requires on the Authorization header.
# Generate and apply with: scripts/apply-auth.sh --generate
MCP_API_KEY=

# Public endpoint of the deployed server, e.g.
#   https://<machine>.<tailnet>.ts.net/mcp-rust-demo
MCP_URL=

# SSH target for the k3s node, e.g. user@host
SSH_HOST=

# Extra kubeconfig to merge with ~/.kube/config, if the cluster is not your default
# context, e.g. $HOME/.kube/my-cluster-config
KUBECONFIG_EXTRA=
